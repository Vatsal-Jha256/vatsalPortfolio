@inproceedings{jha2025caamfa,
  abbr = {ICDSINC},
  pubtype = {conference},
  theme = {systems},
  title       = {CA-AMFA: Context-Aware Adaptive Multi-Factor Authentication for IoT-Based Household Security Systems},
  author      = {Jha, Vatsal and Babu S., Yokesh},
  booktitle   = {IEEE ICDSINC 2025},
  publisher   = {IEEE},
  year        = {2025},
  doi         = {10.1109/ICDSINC66221.2025.11448177},
  html        = {https://ieeexplore.ieee.org/abstract/document/11448177/},
  code        = {https://github.com/Vatsal-Jha256/CA-AMFA-Context-Aware-Adaptive-Multi-Factor-Authentication-for-IoT-Based-Household-Security-Systems},
  award       = {Best Paper Award, ICDSINC 2025.},
  award_name  = {Best Paper},
  abstract    = {A home authentication system that decides, per attempt, how many factors (PIN, TOTP, face) to ask for, using bandit-style online weight updates over contextual risk signals. Runs on a Raspberry Pi prototype. In 11 simulated 30-day runs, Thompson sampling cut the false-acceptance rate by 44.75% against fixed weights, and UCB reduced the average number of factors required from 2.89 to 2.31.},
  bibtex_show = {true},
  selected    = {true}
}

