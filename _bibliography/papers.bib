@inproceedings{jha2026ranking,
  abbr = {NeurIPS W},
  pubtype = {workshop},
  theme = {comparison},
  title       = {Ranking Is Not Valuation: Selection-Aware Carbon Claims under Supplier Shift},
  author      = {Jha, Vatsal and Srivastava, Anupam and Ashok, B.},
  booktitle   = {NeurIPS 2026 Workshop on Tackling Climate Change with Machine Learning},
  year        = {2026},
  abstract    = {Low-carbon product recommenders often use one predicted embodied-carbon score both to pick a product and to report how much carbon that pick saves. Selecting on a prediction favours products whose error happens to be favourable, so the reported saving is biased upward. On 108,326 ready-mix concrete EPDs from 413 manufacturers, evaluated on held-out suppliers, the model ranks products usefully (pairwise accuracy 0.59, above chance in 23 of 24 splits) while its point predictions are poor (mean R² 0.08). Selected mixes are about 10% below their strength-class median, but the model's own score overstates that saving by about 9%. A selection-conditional conformal reporting bound keeps the recommended product unchanged and cuts the share of overstated claims from 51% to 11%.},
  bibtex_show = {true},
  selected    = {true}
}

@inproceedings{jha2026behaviorflmt,
  abbr = {NeurIPS W},
  pubtype = {workshop},
  theme = {scarcity},
  title       = {BehaviorFL-MT: Federated Multi-Task Learning under Unequal Vehicle Sensors and Partial Supervision},
  author      = {Jha, Vatsal and Ashok, B.},
  booktitle   = {NeurIPS 2026 Workshop on New in ML},
  year        = {2026},
  abstract    = {Vehicle fleets differ in which sensors each car has and in which tasks each client can supervise. BehaviorFL-MT trains destination prediction and driving-state models jointly across such a federation, and uses discovery-aware client sampling to find and revisit the rare clients that carry state labels. At a fixed budget of 112 clients per round, this raises exposure to state-supervised clients by 5.8x over uniform sampling and improves state AUPRC by about 0.10 over the strongest federated baseline, across a federation built from three public mobility datasets (VED, GeoLife, T-Drive).},
  bibtex_show = {true},
  selected    = {true}
}

